<!-- app/views/foods/index.html.erb -->
<h1 class="text-3xl font-bold mb-6 text-center">🍴 なに食べたい？</h1>

<!-- 食べ物一覧 -->
<div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6 mb-8">
  <% @foods.each do |food| %>
    <%= link_to foods_path(food_id: food.id), method: :get, class: "block border-2 border-orange-300 rounded-xl p-6 bg-orange-50 text-center transform transition duration-200 hover:scale-105 hover:shadow-lg" do %>
      <p class="font-bold text-lg mb-1"><%= food.name %></p>
      <p class="text-sm text-gray-600"><%= food.calories %> kcal</p>
    <% end %>
  <% end %>
</div>

<!-- 選択された食べ物の詳細 -->
<% if @selected_food %>
  <div class="border-2 border-green-300 rounded-xl p-6 bg-green-50">
    <h2 class="text-2xl font-semibold mb-3"><%= @selected_food.name %></h2>
    <p class="mb-2">カロリー: <%= @selected_food.calories %> kcal</p>

    <h3 class="font-semibold mb-2">消費するには…</h3>
    <ul class="list-disc list-inside mb-4">
      <% @exercises.each do |ex| %>
        <li><%= ex[:name] %>：<%= ex[:minutes] %> 分</li>
      <% end %>
    </ul>

    <p class="bg-pink-100 text-pink-700 p-3 rounded-lg">
      <%= @excuse.comment %>
    </p>

  </div>
<% end %>
